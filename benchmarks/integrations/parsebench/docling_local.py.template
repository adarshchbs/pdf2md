"""Pinned in-process Docling provider copied into the ParseBench checkout."""

from datetime import datetime
from pathlib import Path
from typing import Any

from docling.document_converter import DocumentConverter

from parse_bench.inference.providers.base import Provider, ProviderPermanentError
from parse_bench.inference.providers.parse.docling import DoclingParseProvider
from parse_bench.inference.providers.registry import register_provider
from parse_bench.schemas.pipeline import PipelineSpec
from parse_bench.schemas.pipeline_io import InferenceRequest, RawInferenceResult
from parse_bench.schemas.product import ProductType


@register_provider("docling_local")
class DoclingLocalProvider(DoclingParseProvider):
    """Run Docling locally with its default born-digital PDF pipeline."""

    def __init__(self, provider_name: str, base_config: dict[str, Any] | None = None):
        Provider.__init__(self, provider_name, base_config)
        self._converter = DocumentConverter()

    def run_inference(self, pipeline: PipelineSpec, request: InferenceRequest) -> RawInferenceResult:
        if request.product_type != ProductType.PARSE:
            raise ProviderPermanentError("docling_local only supports PARSE")
        source_path = Path(request.source_file_path)
        if source_path.suffix.lower() != ".pdf" or not source_path.is_file():
            raise ProviderPermanentError(f"PDF file not found: {source_path}")

        started_at = datetime.now()
        conversion = self._converter.convert(source_path)
        document = conversion.document
        pages = [
            {"page": page_number, "markdown": document.export_to_markdown(page_no=page_number)}
            for page_number in sorted(document.pages)
        ]
        completed_at = datetime.now()
        return RawInferenceResult(
            request=request,
            pipeline=pipeline,
            pipeline_name=pipeline.pipeline_name,
            product_type=request.product_type,
            raw_output={
                "pages": pages,
                "markdown": document.export_to_markdown(),
                "docling_document": document.model_dump(mode="json"),
            },
            started_at=started_at,
            completed_at=completed_at,
            latency_in_ms=int((completed_at - started_at).total_seconds() * 1000),
        )
